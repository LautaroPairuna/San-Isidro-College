{
  "$schema": "https://schema.railpack.com",
  "packages": { "node": "24.22.1" },
  "steps": {
    "install": {
      "commands": ["npm install -g npm@11.21.1", "..."]
    },
    "build": {
      "commands": [
        "...",
        "cp -r .next/static .next/standalone/.next/static",
        "cp -r public .next/standalone/public"
      ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "packages:mise",
        "include": ["/mise/shims", "/mise/installs", "/usr/local/bin/mise", "/etc/mise/config.toml", "/root/.local/state/mise"]
      },
      { "step": "build", "include": [".next/standalone"] }
    ],
    "startCommand": "node --max-old-space-size=256 .next/standalone/server.js",
    "variables": { "HOSTNAME": "0.0.0.0", "MALLOC_ARENA_MAX": "2" }
  }
}
