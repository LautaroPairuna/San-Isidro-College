# Copiá este archivo a .env.local (desarrollo) o cargá estas variables en el
# entorno del servidor (producción). El .env real nunca se sube al repo.

# Base de datos (Prisma / MariaDB)
DATABASE_URL="mysql://usuario:contrasena@127.0.0.1:3306/nombre_base"

# --- Acceso al administrador ---------------------------------------------
# Email con el que se inicia sesión en /admin/auth
ADMIN_EMAIL="admin@ejemplo.com"

# Hash bcrypt de la contraseña (NO la contraseña en texto plano). Se genera con:
#   node -e "console.log(require('bcrypt').hashSync('LA_CONTRASEÑA', 10))"
ADMIN_PASSWORD_HASH="$2b$10$reemplazar_por_el_hash_generado"

# --- NextAuth --------------------------------------------------------------
# Clave con la que se firman las sesiones. Se genera con:
#   openssl rand -base64 32
NEXTAUTH_SECRET="reemplazar_por_una_clave_larga_y_aleatoria"

# URL pública del sitio, necesaria en producción
NEXTAUTH_URL="http://localhost:3000"
